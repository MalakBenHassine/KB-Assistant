# Copy to .env, or run `make env` to generate one with random values.
# .env is git-ignored. Never commit real values.

# Schema owner: migrations and the demo seed only.
POSTGRES_PASSWORD=
# Application role used by the API and the worker (row-level security applies).
KB_APP_DB_PASSWORD=
REDIS_PASSWORD=
# Password of every demo user created by `make seed` (12+ characters).
KB_SEED_PASSWORD=

# Host user the API container runs as, so it can read the 0600 signing key.
KB_UID=1000
KB_GID=1000

# Host ports (change them if 8000 or 3000 are taken).
KB_API_PORT=8000
KB_WEB_PORT=3000
